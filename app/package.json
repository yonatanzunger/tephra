{
  "name": "tephra",
  "productName": "Tephra",
  "version": "0.1.0",
  "description": "A notebook that is one continuous stream of writing",
  "main": "out/main/index.cjs",
  "scripts": {
    "dev": "./run.sh --dev",
    "start": "./run.sh",
    "scratch": "./run.sh --scratch",
    "build": "electron-vite build",
    "package": "npm run build && node scripts/package.mjs",
    "install:app": "npm run package && node scripts/install-app.mjs",
    "typecheck": "tsc --build --force tsconfig.json",
    "test": "node --experimental-strip-types --test \"tests/**/*.test.ts\"",
    "test:full": "npm run typecheck && npm test && npm run m0 && npm run m1 && npm run m2 && npm run m3 && npm run m4 && npm run mh1",
    "m0": "npm run build && node scripts/m0-acceptance.mjs",
    "m1": "npm run build && node scripts/m1-acceptance.mjs",
    "m2": "npm run build && node scripts/m2-acceptance.mjs",
    "m3": "npm run build && node scripts/m3-acceptance.mjs",
    "icon": "node scripts/icon.mjs",
    "m4": "npm run build && node scripts/m4-acceptance.mjs",
    "mh1": "npm run build && node scripts/mh1-acceptance.mjs"
  },
  "type": "module",
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@lezer/highlight": "^1.2.3",
    "codemirror": "^6.0.2",
    "isomorphic-git": "^1.41.8",
    "katex": "^0.18.4",
    "pagedjs": "^0.4.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.4.0",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "allowScripts": {
    "electron@43.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "private": true
}
